# Copy to .env and fill in the two required values, then check the setup with: retail-agent doctor

# --- Gemini (required: API key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Free-tier limits (AI Studio, per model and project): *-flash-lite = 15 RPM / 250K TPM / 500 RPD;
# gemini-3-flash, 3.6-flash, 3.8-flash = 5 RPM / 250K TPM / 20 RPD each
AGENT_MODEL=gemini-3.5-flash-lite
# Tried in order when the primary model fails or is rate limited
FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001

# --- BigQuery (required: billing/quota project; auth via `gcloud auth application-default login`) ---
GCP_PROJECT=
BQ_DATASET=bigquery-public-data.thelook_ecommerce
# Optional limits applied to every query (defaults shown)
# BQ_MAX_BYTES_BILLED=1000000000
# BQ_TIMEOUT_S=60
# BQ_MAX_ROWS=1000
