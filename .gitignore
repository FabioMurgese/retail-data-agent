# golden-trio curation at runtime: candidates from /good, the human review queue, rejected candidates.
# Only the READMEs and one real example per outcome folder are tracked.
/golden/candidates/*
!/golden/candidates/README.md
/golden/review/*
!/golden/review/README.md
!/golden/review/2026-11-16-f5ec1bb1ffe5.yaml
/golden/rejected/*
!/golden/rejected/README.md
!/golden/rejected/2026-11-16-bd1b988fdd70.yaml
